POSTGRES_USER=polyarb
POSTGRES_PASSWORD=changeme
POSTGRES_DB=polyarb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
# OpenAI key — required for EMBEDDINGS (pgvector similarity). Kimi/Moonshot has
# no embeddings endpoint, so keep a (minimal) OpenAI key set even when the
# classifier LLM runs on Kimi. Embeddings are cheap (~pennies/month).
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# Code-audit model (scripts/deepseek_audit.py + gemini_audit.py wrapper).
# Defaults to Kimi (Moonshot); legacy DEEPSEEK_* names below still work as a
# fallback, and CLASSIFIER_API_KEY is reused if AUDIT_API_KEY is unset.
AUDIT_API_KEY=
AUDIT_BASE_URL=https://api.moonshot.ai/v1
AUDIT_MODEL=kimi-k2.6
# Legacy DeepSeek audit vars (still honored as a fallback):
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_REASONING_EFFORT=high
GAMMA_API_BASE=https://gamma-api.polymarket.com
CLOB_API_BASE=https://clob.polymarket.com
POLL_INTERVAL_SECONDS=30
RATE_LIMIT_RPS=2
FETCH_ORDER_BOOKS=false
MAX_SNAPSHOT_MARKETS=100
# Hard cap on markets snapshotted per CLOB poll cycle (batch endpoints make
# ~6k markets ~55s; the cap mainly bounds DB growth now)
MAX_CLOB_SNAPSHOTS=500
# Order-book capture: levels kept per side; books only for paired markets
ORDER_BOOK_DEPTH_LEVELS=10
ORDER_BOOKS_PAIRED_ONLY=true
# Persist WS last_trade_price events to the market_trades table
CAPTURE_WS_TRADES=true
# Historical behavior: WS trade prices fold into snapshot prices/midpoints
# (contaminates the frozen-price guard). Flip to false only after taking a
# frozen-rejection-rate baseline (remediation 4.8).
FOLD_TRADE_PRICES_INTO_MIDPOINTS=true
# Retention pruning in days (0 = keep forever); check disk headroom first
SNAPSHOT_RETENTION_DAYS=0
TRADES_RETENTION_DAYS=0
# WS subscription budget (~78k paired tokens causes reconnect churn)
MAX_WS_SUBSCRIPTIONS=3000
LOG_LEVEL=INFO

# Detector settings
SIMILARITY_THRESHOLD=0.82
SIMILARITY_TOP_K=20
DETECTOR_BATCH_SIZE=100
CLASSIFIER_MODEL=gpt-4.1-mini
CLASSIFIER_BASE_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_PROMPT_ADAPTER=auto
# Per-model quirk override (JSON: substring-pattern -> capability fields);
# lets a new provider quirk be fixed here instead of a code hotfix, e.g.
# CLASSIFIER_MODEL_CAPABILITIES={"kimi-k3": {"temperature_label": null}}
CLASSIFIER_MODEL_CAPABILITIES=
# Per-request LLM timeout (retries are app-level, 3 bounded attempts)
CLASSIFIER_TIMEOUT_SECONDS=60
# Consecutive LLM failures per detection cycle before skipping the rest
CLASSIFIER_CYCLE_FAILURE_BUDGET=3
OPENROUTER_API_KEY=
# Kimi (Moonshot) classifier — OpenAI-compatible, free-tier friendly. The
# classifier auto-disables thinking mode and omits temperature for k2.5/k2.6.
# (Embeddings still need OPENAI_API_KEY above — Kimi has no embeddings API.)
# CLASSIFIER_MODEL=kimi-k2.6
# CLASSIFIER_BASE_URL=https://api.moonshot.ai/v1
# CLASSIFIER_API_KEY=<your moonshot/kimi key>
DETECTION_INTERVAL_SECONDS=60
# Dormant-pair filter: stop re-creating opportunities for pairs whose last
# DORMANT_PAIR_MIN_EVALUATIONS optimized opps in the window were all zero-profit
DORMANT_PAIR_ENABLED=true
DORMANT_PAIR_MIN_EVALUATIONS=5
DORMANT_PAIR_WINDOW_SECONDS=1800

# Optimizer settings
FW_MAX_ITERATIONS=200
FW_GAP_TOLERANCE=0.001
FW_IP_TIMEOUT_MS=5000
OPTIMIZER_INTERVAL_SECONDS=30
OPTIMIZER_MIN_EDGE=0.03
OPTIMIZER_SKIP_CONDITIONAL=true

# Simulator settings
INITIAL_CAPITAL=10000.0
MAX_POSITION_SIZE=100.0
SLIPPAGE_MODEL=vwap
SIMULATOR_INTERVAL_SECONDS=60
# For this long after simulator boot, only trade markets snapshotted after
# boot (pre-restart quotes can be stale-but-fresh-looking). Keep >=
# MAX_SNAPSHOT_AGE_SECONDS to fully close the pre-boot window. 0 disables.
SIMULATOR_STARTUP_GRACE_SECONDS=600
# Max dollars of NEW exposure (long buys + short sells) one pair may open
# per rolling window; bounds single-pair concentration. 0 disables.
MAX_PAIR_WEEKLY_FLOW=100.0
PAIR_FLOW_WINDOW_SECONDS=604800
# Frozen-price guard: reject trades whose midpoint hasn't moved across
# PRICE_STALENESS_MIN_OBSERVATIONS snapshots in the look-back window
REJECT_FROZEN_PRICES=true
PRICE_STALENESS_WINDOW_SECONDS=3600
PRICE_STALENESS_MIN_OBSERVATIONS=4
# Frozen-pair cooldown: after FROZEN_PAIR_REJECT_THRESHOLD frozen-price
# rejections within the window, stop re-detecting the pair and stop polling
# its markets for the cooldown period (self-expires; WS revives woken markets)
FROZEN_PAIR_REJECT_THRESHOLD=5
FROZEN_PAIR_REJECT_WINDOW_SECONDS=1800
FROZEN_PAIR_COOLDOWN_SECONDS=14400
# Positions with no snapshot newer than this are valued at cost basis
VALUATION_MAX_SNAPSHOT_AGE_SECONDS=3600
# SIMULATOR_RESET_EPOCH=2026-03-21T15:02:00Z  # Filter dashboard to only show data after this timestamp

# Circuit breaker settings
CB_MAX_DAILY_LOSS=500.0
CB_MAX_POSITION_PER_MARKET=200.0
CB_MAX_DRAWDOWN_PCT=10.0
CB_MAX_CONSECUTIVE_ERRORS=5
CB_COOLDOWN_SECONDS=300

# Kalshi settings (OFF by default)
KALSHI_ENABLED=false
KALSHI_API_KEY=
KALSHI_API_SECRET=
KALSHI_POLL_INTERVAL_SECONDS=120
KALSHI_MAX_MARKETS=500
KALSHI_RATE_LIMIT_RPS=1.5

# Dashboard settings
DASHBOARD_PORT=8080

# Live trading settings (OFF by default — requires manual enable)
LIVE_TRADING_ENABLED=false
LIVE_TRADING_DRY_RUN=true
LIVE_TRADING_API_KEY=
LIVE_TRADING_PRIVATE_KEY=
LIVE_TRADING_CHAIN_ID=137
LIVE_TRADING_SIGNATURE_TYPE=0
LIVE_TRADING_FUNDER=
LIVE_TRADING_BANKROLL=100.0
LIVE_TRADING_MAX_POSITION_SIZE=10.0
LIVE_TRADING_MIN_EDGE=0.03
LIVE_TRADING_MAX_DAILY_LOSS_PCT=10.0
LIVE_SNAPSHOT_INTERVAL_SECONDS=300
LIVE_STATUS_HEARTBEAT_SECONDS=30
LIVE_RECONCILE_INTERVAL_SECONDS=5
